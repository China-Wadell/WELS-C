函 圆周率 () -> 双精 {
    返 3.14159;
}

函 半 (x: 双精) -> 双精 {
    返 x / 2.0;
}

函 主 () -> 整数 {
    a 为 浮点 1.5;
    b 为 浮点 2.5;
    c 为 浮点 a + b;
    打印("float c = ", c, \n);

    d 为 双精 1.5;
    e 为 双精 2.5;
    f 为 双精 d + e;
    打印("double f = ", f, \n);

    pi 为 双精 圆周率();
    打印("pi = ", pi, \n);

    h 为 双精 半(pi);
    打印("half = ", h, \n);

    若 c > 3.9 && c < 4.1 && f > 3.9 && f < 4.1 {
        打印("浮点通过"\n);
    } 否则 {
        打印("浮点失败"\n);
    }
    返 0;
}
