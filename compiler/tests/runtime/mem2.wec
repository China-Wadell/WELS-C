#<io.weh>
#<mem.weh>

函 主 () -> 整数 {
    a 为 字符 指针 分配(16);
    b 为 字符 指针 分配(16);

    内存填充(a, 65, 10);
    a[10] = 0;
    打印行(a);

    内存复制(b, a, 11);
    打印行(b);

    打印整数(内存比较(a, b, 10));
    打印行("");

    b[3] = 66;
    打印整数(内存比较(a, b, 10));
    打印行("");

    清零(b, 16);
    打印整数(b[0]);
    打印行("");

    释放(a);
    释放(b);
    返 0;
}
