#<io.weh>
#<string.weh>
#<mem.weh>

函 主 () -> 整数 {
    buf 为 字符串 分配(64);
    buf2 为 字符串 分配(64);

    复制(buf, "hello");
    打印行(buf);
    打印整数(长度(buf));
    打印行("");

    拼接(buf, ", world");
    打印行(buf);
    打印整数(长度(buf));
    打印行("");

    复制(buf2, "abcde");
    反转(buf2, 5);
    打印行(buf2);

    整数转字符串(12345, buf2);
    打印行(buf2);

    打印整数(字符串转整数("6789"));
    打印行("");

    打印整数(大写(97));
    打印行("");
    打印整数(小写(65));
    打印行("");

    打印整数(是否数字(53));
    打印行("");
    打印整数(是否数字(65));
    打印行("");

    释放(buf);
    释放(buf2);
    返 0;
}
