#<io.weh>
#<math.weh>

函 主 () -> 整数 {
    打印行("阶乘 5:");
    打印整数(阶乘(5));
    打印行("");

    打印行("7 是否为素数:");
    打印整数(是否为素数(7));
    打印行("");

    打印行("8 是否为素数:");
    打印整数(是否为素数(8));
    打印行("");

    打印行("gcd(12, 18):");
    打印整数(最大公约数(12, 18));
    打印行("");

    打印行("sqrt(2):");
    打印浮点(双精平方根(2.0));
    打印行("");

    返 0;
}
