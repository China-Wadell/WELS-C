#<io.weh>
#<string.weh>

函 主 () -> 整数 {
    打印行("长度(hello):");
    打印整数(长度("hello"));
    打印行("");

    打印行("字符查找(hello, l):");
    打印整数(字符查找("hello", 108));
    打印行("");

    打印行("子串查找(hello world, world):");
    打印整数(子串查找("hello world", "world"));
    打印行("");

    打印行("子串查找(hello world, xyz):");
    打印整数(子串查找("hello world", "xyz"));
    打印行("");

    返 0;
}
