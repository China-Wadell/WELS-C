#<io.weh>
#<stdlib.weh>

函 主 () -> 整数 {
    arr 为 整数 数组 { 5, 2, 8, 1, 9, 3, 7, 4, 6 };
    整数排序(arr, 9);
    i 为 长整 0;
    循环 i 为 长整 0; i < 9; i = i + 1 {
        打印整数(arr[i]);
        打印行(" ");
    }
    打印行("");

    打印整数(整数最大值(arr, 9));
    打印行("");
    打印整数(整数最小值(arr, 9));
    打印行("");
    打印整数(整数求和(arr, 9));
    打印行("");

    打印整数(二分查找(arr, 9, 7));
    打印行("");
    打印整数(二分查找(arr, 9, 100));
    打印行("");

    返 0;
}
