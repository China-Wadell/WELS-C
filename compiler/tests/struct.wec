结构 学生 (字符串 名字, 整数 年龄) {
    学生1 ("张三", 18);
    学生2 ("李四", 20);
};

结构 点 整数 (x, y) {
    点1 (3, 4);
};

函 主 () -> 整数 {
    打印("学生1: ", 学生1.名字, " ", 学生1.年龄, \n);
    打印("学生2: ", 学生2.名字, " ", 学生2.年龄, \n);
    打印("点1: ", 点1.x, " ", 点1.y, \n);

    p 为 整数 指针 0;
    p = &点1;
    打印("p->x = ", p->x, \n);
    p->x = 100;
    若 点1.x == 100 {
        打印("结构体通过"\n);
    }
    返 0;
}
