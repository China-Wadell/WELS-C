函 加 (a: 整数, b: 整数) -> 整数 {
    返 a + b;
}

函 减 (a: 整数, b: 整数) -> 整数 {
    返 a - b;
}

函 主 () -> 整数 {
    f 为 函 指针 0;
    *f = 加;
    x 为 整数 (*f)(1, 2);
    打印("x = ", x, \n);

    *f = 减;
    y 为 整数 (*f)(10, 4);
    打印("y = ", y, \n);

    若 x == 3 && y == 6 {
        打印("函数指针通过"\n);
    }
    返 0;
}
