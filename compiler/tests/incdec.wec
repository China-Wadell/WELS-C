函 主 () -> 整数 {
    a 为 整数 10;
    a += 5;
    a -= 3;
    a *= 2;
    a /= 4;
    a %= 4;
    a <<= 3;
    a >>= 2;
    a |= 1;
    a &= 3;

    b 为 整数 5;
    b++;
    b--;
    ++b;
    --b;

    c 为 整数 b++;
    d 为 整数 ++b;

    若 a == 1 && c == 5 && d == 7 {
        打印("复合赋值+自增自减通过"\n);
    } 否则 {
        打印("失败 a=", a, " c=", c, " d=", d, \n);
    }
    返 0;
}
