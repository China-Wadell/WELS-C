函 交换 (a: 整数 指针, b: 整数 指针) -> 空 {
    t 为 整数 *a;
    *a = *b;
    *b = t;
}

函 冒泡排序 (arr: 整数 指针, n: 整数) -> 空 {
    i 为 整数 0;
    循环 i = 0; i < n - 1; i = i + 1 {
        j 为 整数 0;
        循环 j = 0; j < n - 1 - i; j = j + 1 {
            若 arr[j] > arr[j + 1] {
                交换(&arr[j], &arr[j + 1]);
            }
        }
    }
}

函 打印数组 (arr: 整数 指针, n: 整数) -> 空 {
    i 为 整数 0;
    循环 i = 0; i < n; i = i + 1 {
        打印(arr[i], " ");
    }
    打印(\n);
}

函 主 () -> 整数 {
    a 为 整数 数组 { 5, 2, 8, 1, 9, 3, 7, 4, 6 };
    打印("排序前: ");
    打印数组(a, 9);
    冒泡排序(a, 9);
    打印("排序后: ");
    打印数组(a, 9);
    返 0;
}
