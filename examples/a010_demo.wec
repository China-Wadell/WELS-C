_注释_ a0.1.0 验收程序 —— 素数筛 + 排序 + 字符串 + 数学

#<io.weh>
#<math.weh>
#<string.weh>
#<mem.weh>

函 打印数组 (arr: 整数 数组, n: 整数) -> 空 {
    i 为 整数 0;
    循环 i = 0; i < n; i = i + 1 {
        打印整数(arr[i]);
        打印行(" ");
    }
    打印行("");
}

函 冒泡排序 (arr: 整数 数组, n: 整数) -> 空 {
    i 为 整数 0;
    循环 i = 0; i < n - 1; i = i + 1 {
        j 为 整数 0;
        循环 j = 0; j < n - 1 - i; j = j + 1 {
            若 arr[j] > arr[j + 1] {
                t 为 整数 arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = t;
            }
        }
    }
}

函 素数筛 (n: 整数) -> 空 {
    sieve 为 字符 指针 分配(n);
    i 为 整数 0;
    循环 i = 0; i < n; i = i + 1 {
        sieve[i] = 0;
    }
    sieve[0] = 1;
    sieve[1] = 1;
    i = 2;
    循环 i = 2; i * i < n; i = i + 1 {
        若 sieve[i] == 0 {
            j 为 整数 i * i;
            循环 j = i * i; j < n; j = j + i {
                sieve[j] = 1;
            }
        }
    }
    count 为 整数 0;
    打印行("素数：");
    循环 i = 2; i < n; i = i + 1 {
        若 sieve[i] == 0 {
            打印整数(i);
            打印行(" ");
            count = count + 1;
        }
    }
    打印行("");
    打印行("总数：");
    打印整数(count);
    打印行("");
}

函 主 () -> 整数 {
    打印行("=== 素数筛 ===");
    素数筛(100);

    打印行("");
    打印行("=== 排序 ===");
    arr 为 整数 数组 { 64, 34, 25, 12, 22, 11, 90, 5, 77, 33 };
    打印行("排序前：");
    打印数组(arr, 10);
    冒泡排序(arr, 10);
    打印行("排序后：");
    打印数组(arr, 10);

    打印行("");
    打印行("=== 字符串 ===");
    s 为 字符串 "hello, WELS-C!";
    打印行(s);
    打印行("长度：");
    打印整数(长度(s));
    打印行("");
    打印行("查找 WELS：");
    打印整数(子串查找(s, "WELS"));
    打印行("");

    打印行("");
    打印行("=== 数学 ===");
    打印行("阶乘 10：");
    打印整数(阶乘(10));
    打印行("");
    打印行("gcd(48, 36)：");
    打印整数(最大公约数(48, 36));
    打印行("");

    返 0;
}
