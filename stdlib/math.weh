_注释_ math.weh — WELS-C 数学库

函 加 (a: 整数, b: 整数) -> 整数 {
    返 a + b;
}

函 减 (a: 整数, b: 整数) -> 整数 {
    返 a - b;
}

函 乘 (a: 整数, b: 整数) -> 整数 {
    返 a * b;
}

函 除 (a: 整数, b: 整数) -> 整数 {
    返 a / b;
}

函 取模 (a: 整数, b: 整数) -> 整数 {
    返 a % b;
}

函 最大 (a: 整数, b: 整数) -> 整数 {
    若 a > b { 返 a; }
    返 b;
}

函 最小 (a: 整数, b: 整数) -> 整数 {
    若 a < b { 返 a; }
    返 b;
}

函 绝对值 (a: 整数) -> 整数 {
    若 a < 0 { 返 0 - a; }
    返 a;
}

函 平方 (a: 整数) -> 整数 {
    返 a * a;
}

函 幂 (base: 整数, n: 整数) -> 整数 {
    r 为 整数 1;
    i 为 整数 0;
    循环 i = 0; i < n; i = i + 1 {
        r = r * base;
    }
    返 r;
}

函 双精最大 (a: 双精, b: 双精) -> 双精 {
    若 a > b { 返 a; }
    返 b;
}

函 双精最小 (a: 双精, b: 双精) -> 双精 {
    若 a < b { 返 a; }
    返 b;
}

函 双精绝对值 (a: 双精) -> 双精 {
    若 a < 0.0 { 返 0.0 - a; }
    返 a;
}
