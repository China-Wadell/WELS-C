_注释_ math.weh — WELS-C 数学库

_注释_ 整数部分
函 加 (a: 整数, b: 整数) -> 整数 { 返 a + b; }
函 减 (a: 整数, b: 整数) -> 整数 { 返 a - b; }
函 乘 (a: 整数, b: 整数) -> 整数 { 返 a * b; }
函 除 (a: 整数, b: 整数) -> 整数 { 返 a / b; }
函 取模 (a: 整数, b: 整数) -> 整数 { 返 a % b; }

函 最大 (a: 整数, b: 整数) -> 整数 {
    若 a > b { 返 a; }
    返 b;
}
函 最小 (a: 整数, b: 整数) -> 整数 {
    若 a < b { 返 a; }
    返 b;
}
函 绝对值 (a: 整数) -> 整数 {
    若 a < 0 { 返 0 - a; }
    返 a;
}

函 平方 (a: 整数) -> 整数 { 返 a * a; }
函 立方 (a: 整数) -> 整数 { 返 a * a * a; }

函 幂 (base: 整数, n: 整数) -> 整数 {
    r 为 整数 1;
    i 为 整数 0;
    循环 i = 0; i < n; i = i + 1 {
        r = r * base;
    }
    返 r;
}

函 阶乘 (n: 整数) -> 整数 {
    r 为 整数 1;
    i 为 整数 1;
    循环 i = 1; i <= n; i = i + 1 {
        r = r * i;
    }
    返 r;
}

函 是否为素数 (n: 整数) -> 整数 {
    若 n < 2 { 返 0; }
    i 为 整数 2;
    循环 i = 2; i * i <= n; i = i + 1 {
        若 n % i == 0 { 返 0; }
    }
    返 1;
}

函 最大公约数 (a: 整数, b: 整数) -> 整数 {
    x 为 整数 a;
    y 为 整数 b;
    当 y \= 0 {
        t 为 整数 x % y;
        x = y;
        y = t;
    }
    返 x;
}

函 最小公倍数 (a: 整数, b: 整数) -> 整数 {
    返 a * b / 最大公约数(a, b);
}

_注释_ 双精部分
函 双精加 (a: 双精, b: 双精) -> 双精 { 返 a + b; }
函 双精减 (a: 双精, b: 双精) -> 双精 { 返 a - b; }
函 双精乘 (a: 双精, b: 双精) -> 双精 { 返 a * b; }
函 双精除 (a: 双精, b: 双精) -> 双精 { 返 a / b; }

函 双精最大 (a: 双精, b: 双精) -> 双精 {
    若 a > b { 返 a; }
    返 b;
}
函 双精最小 (a: 双精, b: 双精) -> 双精 {
    若 a < b { 返 a; }
    返 b;
}
函 双精绝对值 (a: 双精) -> 双精 {
    若 a < 0.0 { 返 0.0 - a; }
    返 a;
}
函 双精平方 (a: 双精) -> 双精 { 返 a * a; }

函 双精幂 (base: 双精, n: 整数) -> 双精 {
    r 为 双精 1.0;
    i 为 整数 0;
    循环 i = 0; i < n; i = i + 1 {
        r = r * base;
    }
    返 r;
}

函 双精平方根 (a: 双精) -> 双精 {
    _注释_ 牛顿迭代：x = (x + a/x) / 2
    若 a <= 0.0 { 返 0.0; }
    x 为 双精 a;
    i 为 整数 0;
    循环 i = 0; i < 20; i = i + 1 {
        x = (x + a / x) / 2.0;
    }
    返 x;
}
