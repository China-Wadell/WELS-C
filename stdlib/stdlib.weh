_注释_ stdlib.weh — WELS-C 通用工具库

#<string.weh>

_注释_ 整数排序（冒泡，升序，原地）_
函 整数排序 (arr: 整数 数组, n: 长整) -> 空 {
    i 为 长整 0;
    循环 i 为 长整 0; i < n - 1; i = i + 1 {
        j 为 长整 0;
        循环 j 为 长整 0; j < n - 1 - i; j = j + 1 {
            若 arr[j] > arr[j + 1] {
                t 为 整数 arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = t;
            }
        }
    }
}

_注释_ 整数数组二分查找：找到返下标，找不到返 -1。数组必须升序。_
函 二分查找 (arr: 整数 数组, n: 长整, target: 整数) -> 长整 {
    lo 为 长整 0;
    hi 为 长整 n - 1;
    当 lo <= hi {
        mid 为 长整 (lo + hi) / 2;
        若 arr[mid] == target { 返 mid; }
        若 arr[mid] < target { lo = mid + 1; }
        否则 { hi = mid - 1; }
    }
    返 0 - 1;
}

_注释_ 最小最大_
函 整数最大值 (arr: 整数 数组, n: 长整) -> 整数 {
    m 为 整数 arr[0];
    i 为 长整 1;
    循环 i 为 长整 1; i < n; i = i + 1 {
        若 arr[i] > m { m = arr[i]; }
    }
    返 m;
}

函 整数最小值 (arr: 整数 数组, n: 长整) -> 整数 {
    m 为 整数 arr[0];
    i 为 长整 1;
    循环 i 为 长整 1; i < n; i = i + 1 {
        若 arr[i] < m { m = arr[i]; }
    }
    返 m;
}

函 整数求和 (arr: 整数 数组, n: 长整) -> 长整 {
    s 为 长整 0;
    i 为 长整 0;
    循环 i 为 长整 0; i < n; i = i + 1 {
        s = s + arr[i];
    }
    返 s;
}

_注释_ 伪随机数（线性同余）_
种子 为 静态 长整 12345;

函 随机 () -> 长整 {
    种子 = 种子 * 1103515245 + 12345;
    返 (种子 / 65536) % 32768;
}

函 设置随机种子 (s: 长整) -> 空 {
    种子 = s;
}

函 随机范围 (lo: 长整, hi: 长整) -> 长整 {
    返 lo + 随机() % (hi - lo + 1);
}
