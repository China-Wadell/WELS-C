_注释_ string.weh — WELS-C 字符串库

外来 函 wels_strcmp (a: 字符串, b: 字符串) -> 整数;

函 长度 (s: 字符串) -> 长整 {
    n 为 长整 0;
    当 s[n] \= 0 {
        n = n + 1;
    }
    返 n;
}

函 比较 (a: 字符串, b: 字符串) -> 整数 {
    返 wels_strcmp(a, b);
}

函 相等 (a: 字符串, b: 字符串) -> 整数 {
    若 wels_strcmp(a, b) == 0 { 返 1; }
    返 0;
}

函 是否为空 (s: 字符串) -> 整数 {
    若 s[0] == 0 { 返 1; }
    返 0;
}

函 字符查找 (s: 字符串, c: 整数) -> 长整 {
    i 为 长整 0;
    当 s[i] \= 0 {
        若 s[i] == c { 返 i; }
        i = i + 1;
    }
    返 0 - 1;
}

函 子串查找 (hay: 字符串, needle: 字符串) -> 长整 {
    hn 为 长整 长度(hay);
    nn 为 长整 长度(needle);
    若 nn == 0 { 返 0; }
    若 nn > hn { 返 0 - 1; }
    i 为 长整 0;
    循环 i 为 长整 0; i <= hn - nn; i = i + 1 {
        j 为 长整 0;
        found 为 整数 1;
        循环 j 为 长整 0; j < nn; j = j + 1 {
            若 hay[i + j] \= needle[j] {
                found = 0;
                跳;
            }
        }
        若 found == 1 { 返 i; }
    }
    返 0 - 1;
}
