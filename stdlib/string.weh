_注释_ string.weh — WELS-C 字符串库

外来 函 wels_strcmp (a: 字符串, b: 字符串) -> 整数;

_注释_ 长度_
函 长度 (s: 字符串) -> 长整 {
    n 为 长整 0;
    当 s[n] \= 0 {
        n = n + 1;
    }
    返 n;
}

_注释_ 比较_
函 比较 (a: 字符串, b: 字符串) -> 整数 {
    返 wels_strcmp(a, b);
}

函 相等 (a: 字符串, b: 字符串) -> 整数 {
    若 wels_strcmp(a, b) == 0 { 返 1; }
    返 0;
}

函 是否为空 (s: 字符串) -> 整数 {
    若 s[0] == 0 { 返 1; }
    返 0;
}

_注释_ 查找_
函 字符查找 (s: 字符串, c: 整数) -> 长整 {
    i 为 长整 0;
    当 s[i] \= 0 {
        若 s[i] == c { 返 i; }
        i = i + 1;
    }
    返 0 - 1;
}

函 子串查找 (hay: 字符串, needle: 字符串) -> 长整 {
    hn 为 长整 长度(hay);
    nn 为 长整 长度(needle);
    若 nn == 0 { 返 0; }
    若 nn > hn { 返 0 - 1; }
    i 为 长整 0;
    循环 i 为 长整 0; i <= hn - nn; i = i + 1 {
        j 为 长整 0;
        found 为 整数 1;
        循环 j 为 长整 0; j < nn; j = j + 1 {
            若 hay[i + j] \= needle[j] {
                found = 0;
                跳;
            }
        }
        若 found == 1 { 返 i; }
    }
    返 0 - 1;
}

_注释_ 复制：返回写入长度（不含 \0）_
函 复制 (dst: 字符串, src: 字符串) -> 长整 {
    i 为 长整 0;
    当 src[i] \= 0 {
        dst[i] = src[i];
        i = i + 1;
    }
    dst[i] = 0;
    返 i;
}

_注释_ 拼接：返回拼接后总长度_
函 拼接 (dst: 字符串, src: 字符串) -> 长整 {
    d 为 长整 长度(dst);
    i 为 长整 0;
    当 src[i] \= 0 {
        dst[d + i] = src[i];
        i = i + 1;
    }
    dst[d + i] = 0;
    返 d + i;
}

_注释_ 反转前 n 个字符_
函 反转 (s: 字符串, n: 长整) -> 空 {
    i 为 长整 0;
    当 i < n / 2 {
        t 为 字符 s[i];
        s[i] = s[n - 1 - i];
        s[n - 1 - i] = t;
        i = i + 1;
    }
}

_注释_ 整数转字符串：返回写入长度_
函 整数转字符串 (n: 长整, buf: 字符串) -> 长整 {
    i 为 长整 0;
    若 n == 0 {
        buf[0] = 48;
        buf[1] = 0;
        返 1;
    }
    neg 为 整数 0;
    若 n < 0 { neg = 1; n = 0 - n; }
    当 n > 0 {
        buf[i] = 48 + n % 10;
        n = n / 10;
        i = i + 1;
    }
    若 neg == 1 {
        buf[i] = 45;
        i = i + 1;
    }
    buf[i] = 0;
    反转(buf, i);
    返 i;
}

_注释_ 字符串转整数_
函 字符串转整数 (s: 字符串) -> 长整 {
    i 为 长整 0;
    neg 为 整数 0;
    若 s[0] == 45 { neg = 1; i = 1; }
    n 为 长整 0;
    当 s[i] >= 48 && s[i] <= 57 {
        n = n * 10 + (s[i] - 48);
        i = i + 1;
    }
    若 neg == 1 { 返 0 - n; }
    返 n;
}

_注释_ 字符判断_
函 是否数字 (c: 整数) -> 整数 {
    若 c >= 48 && c <= 57 { 返 1; }
    返 0;
}

函 是否字母 (c: 整数) -> 整数 {
    若 c >= 65 && c <= 90 { 返 1; }
    若 c >= 97 && c <= 122 { 返 1; }
    返 0;
}

函 是否空白 (c: 整数) -> 整数 {
    若 c == 32 { 返 1; }
    若 c == 9 { 返 1; }
    若 c == 10 { 返 1; }
    若 c == 13 { 返 1; }
    返 0;
}

函 大写 (c: 整数) -> 整数 {
    若 c >= 97 && c <= 122 { 返 c - 32; }
    返 c;
}

函 小写 (c: 整数) -> 整数 {
    若 c >= 65 && c <= 90 { 返 c + 32; }
    返 c;
}
